# =============================================================================
# PhiOTWeb — Environment configuration
# =============================================================================
# Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# Never commit `.env` to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of hostnames the app can serve
# Example: localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins for CSRF (required when using HTTPS in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Django timezone (IANA name). Examples: UTC, America/New_York, Europe/London
TIME_ZONE=UTC

# Language code for the application
LANGUAGE_CODE=en-us


# -----------------------------------------------------------------------------
# Database (SQLite)
# -----------------------------------------------------------------------------

# Path to the SQLite database file (relative to project root or absolute)
DATABASE_PATH=db.sqlite3


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Length of auto-generated device tokens (used in MQTT topics)
DEVICE_TOKEN_LENGTH=15


# -----------------------------------------------------------------------------
# MQTT broker
# -----------------------------------------------------------------------------
# Device commands are published to: {MQTT_PUBLISH_TOPIC_PREFIX}{device_token}
# Publishing is disabled until MQTT_BROKER_HOST is set.

# Broker hostname or IP (leave empty until your broker is ready)
MQTT_BROKER_HOST=

# Broker port (1883 for plain MQTT, 8883 for TLS)
MQTT_BROKER_PORT=1883

# Broker credentials (leave empty if your broker has no auth)
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic prefix for outbound device messages
MQTT_PUBLISH_TOPIC_PREFIX=inTopic/

# Set to True if the broker requires TLS/SSL (e.g. port 8883)
MQTT_USE_TLS=False


# -----------------------------------------------------------------------------
# Development server (optional)
# -----------------------------------------------------------------------------

# Host and port for `python manage.py runserver`
# Not read by Django automatically — pass when starting the server, e.g.:
#   python manage.py runserver 0.0.0.0:5001
RUNSERVER_HOST=127.0.0.1
RUNSERVER_PORT=5001
